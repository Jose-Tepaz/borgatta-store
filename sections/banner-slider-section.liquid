  "presets": [
    {
      "name": "Banner Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "layout": "grid",
            "grid_columns": 4,
            "grid_rows": 2,
            "cell0_col_span": 2,
            "cell0_row_span": 2,
            "tag": "Explora nuestras últimas novedades",
            "title": "Productos nuevos",
            "button_label": "Ver productos",
            "button_style": "outline"
          }
        },
        {
          "type": "slide",
          "settings": {
            "layout": "single",
            "tag": "Colección exclusiva",
            "title": "Descubre lo nuevo",
            "button_label": "Ver colección",
            "button_style": "outline"
          }
        }
      ]
