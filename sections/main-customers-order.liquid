    height: 48px;
}

.label-fomr_fact {
    font-weight: 600;
}

.input-fomr_fact {
    color: #242424;
    background-color: rgba(243, 243, 243, 0);
    border-radius: 20px;
    font-weight: 400;
    border-style: solid;
    border-width: 1px;
    border-color: #bbbbbb;
    height: 24px;
    padding: 8px;
}

.solicitar-factura {
    background-color: #426fcd;
    border: 2px solid #426fcd;
    border-radius: 30px;
    padding: 12px 32px;
    color: #fff;
}

.enviarBtn {
    background-color: #426fcd;
    border: 2px solid #426fcd;
    border-radius: 30px;
    padding: 12px 32px;
    color: #fff;
}

.no-factura {
    color: #426fcd;
    background-color: rgba(56, 152, 236, 0);
    border: 2px solid #426fcd;
    border-radius: 30px;
    padding: 12px 32px;
}

.form {
    font-family: Montserrat, sans-serif;
    font-weight: 300;
}

.submit-button {
    background-color: #426fcd;
    border: 2px solid #426fcd;
    border-radius: 30px;
    padding: 12px 32px;
    font-weight: 500;
    color: #fff;
}
.submit-button:hover {
    color: #426fcd;
    background-color: rgba(56, 152, 236, 0);
    border: 2px solid #426fcd;
    border-radius: 30px;
    padding: 12px 32px;
}

{% endstyle %}

