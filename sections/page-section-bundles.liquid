<div class="container container-large">
  <div class="custom-component">
    <div class="wrapp-img-text">
       {% if section.settings.custom_image %}
    <div class="custom-image">
      <img src="{{ section.settings.custom_image | img_url: 'master' }}" alt="Custom Image">
    </div>

        {% if section.settings.custom_text %}
    <div class="custom-text">
      <p>{{ section.settings.custom_text }}</p>
    </div>
  {% endif %}
  {% endif %}
    </div>
    <div class="wrapp-video">
     {% if section.settings.custom_video %}
      <div class="custom-video-wrapper">
        <video id="custom-video" controls style="display: none;" >
          <source src="{{ section.settings.custom_video }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
        {% if section.settings.video_cover %}
        <div class="video-cover" style="background-image: url('{{ section.settings.video_cover | img_url: 'master' }}');"></div>
      {% endif %}
        <div class="video-overlay">
          <img src="https://cdn.shopify.com/s/files/1/0588/7721/4871/files/play-button.png?v=1723574075" alt="Play Button" class="play-button">
        </div>
    </div>
  {% endif %}
      
    </div>
  

  

  
</div>
  
</div>




<style>
  .container-large {
    width: 100%;
    max-width: 1200px;
  }
.custom-component {
     display: flex;
    flex-direction: row;

    align-items: stretch;
    text-align: center;
    margin-top: 82px;
  gap: 72px;
}
.wrapp-img-text{
  display: flex;
  flex-direction: column;
  gap: 24px;
  line-height: 43.2px;
}
  
.custom-image img {
  max-width: 100%;
  height: auto;
  margin-bottom: 10px;
  border-radius: 45px;
}

  .wrapp-video {
    width: 100%;
    min-width: 350px;
    height: auto;
  }


  .custom-video-wrapper {
  position: relative;
  max-width: 100%;
  height: 625px;
        border-radius: 40px;
    overflow: hidden;
}

.custom-video-wrapper video {
  width: 100%;
  max-width: 100%;
  height: 100%;

}

  .video-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
}

.custom-text p {
  margin: 0px;
  font-size: 20px;
  color: #111314;
  text-align: left;
  line-height: 1.2em;
  
}

  .container-large{
    width: 100%;
    max-width: 1200px;
    margin: auto;
  }
  .video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
}

.play-button {
  width: 64px;
  height: 64px;
  opacity: 0.8;
}

.play-button:hover {
  opacity: 1;
}

  @media (min-width: 481px) and (max-width: 900px) {
  .wrapp-img-text
    {
      gap: 32px;
    }
 .custom-component {
        flex-direction: column;
  }
     .custom-text p {
    font-size: 26px;
       line-height: 1.8em;
  }
  
}

@media (min-width: 320px) and (max-width: 480px) {
 
.wrapp-img-text
    {
      gap: 20px;
    }
  .custom-text p {
    font-size: 20px;
    line-height: 1.8em;
    
  }
  
  .custom-component {
    margin-top:48px;
        flex-direction: column;
    gap:32px
  }
  .wrapp-video {
        width: 100%;
    min-width: 100%;
  }

  .custom-video-wrapper{
    height: 610px;
  }
  
}



  
</style>

<script>
document.querySelector('.video-overlay').addEventListener('click', function() {
  var video = document.getElementById('custom-video');
  video.style.display = 'block';
  video.play();
  document.querySelector('.video-cover').style.display = 'none';
  this.style.display = 'none';
});
</script>


{% schema %}
{
  "name": "Custom Media Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom Image"
    },
    {
      "type": "url",
      "id": "custom_video",
      "label": "Custom Video URL"
    },
     {
      "type": "image_picker",
      "id": "video_cover",
      "label": "Video Cover Image"
    },
    {
      "type": "richtext",
      "id": "custom_text",
      "label": "Custom Text",
      "default": "<p>This is some custom text.</p>"
    }
  ],
  "presets": [
    {
      "name": "Custom Media Section"
    }
  ]
}
{% endschema %}
