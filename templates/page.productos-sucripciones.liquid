    width: 100%;
  max-width:900px;
  padding: 32px 20px 0px 20px;
}

  h2 {
  font-size: 29px;
  color: #161C1F;
  font-weight: 700;
  margin-bottom: 20px;
  margin-top: 0;
  line-height:1.2em;
}

.wrapp-all-products{
  display: grid;
     align-items: start;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin: auto;
    width: 100%;
  max-width:900px;
  padding: 32px 20px;
}
  
 .products-accordion {
  max-width: 720px;
 height:auto;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 8px #e2e8f0;
 
}
.accordion-item + .accordion-item {
  border-top: 1.5px solid #bcd4e6;
}
.accordion-title {
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  outline: none;
  padding: 18px 28px 18px 18px;
  font-size: 1.11rem;
  color: #24588b;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background 0.14s;
}
.accordion-title:hover {
  background: #f0f6fa;
}
.chevron {
  transition: transform 0.26s;
  display: inline-block;
  margin-left: 10px;
}
.accordion-item.open .chevron {
  transform: rotate(180deg);
}
.accordion-content {
  display: none;
  padding: 0 26px 18px 36px;
  animation: fadein 0.18s;
}
.accordion-item.open .accordion-content {
  display: block;
}
.variant-title {
  font-weight: 600;
  color: #123452;
  margin: 10px 0 8px 0;
  font-size: 1.01rem;
}
.accordion-content ul {
  list-style: none;
  padding-left: 0;
  margin: 0;
}
.accordion-content li {
  color: #212b36;
  font-size: 1.02rem;
  margin-bottom: 7px;
  padding-left: 0;
  line-height: 1.2em;
}
@media (max-width: 650px) {
  .wrapp-all-products{
    grid-template-columns: 1fr;
  }
  .products-accordion {
    padding: 6px 0;
  }
  .accordion-title {
    padding: 16px 18px 16px 11px;
    font-size: 1.01rem;
  }
  .accordion-content {
    padding: 0 11px 15px 19px;
  }
}

</style>
  <script>
document.addEventListener('DOMContentLoaded', function() {
  var accordions = document.querySelectorAll('.products-accordion .accordion-item');
  accordions.forEach(function(item) {
    var btn = item.querySelector('.accordion-title');
    btn.addEventListener('click', function() {
      // Si ya está abierto, ciérralo; si no, cierra los demás y abre este
      if (item.classList.contains('open')) {
        item.classList.remove('open');
      } else {
        accordions.forEach(i => i.classList.remove('open'));
        item.classList.add('open');
      }
    });
  });
});
</script>


</style>