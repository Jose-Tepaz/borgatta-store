{%- comment -%}
  Shared collection rules, evaluated in editor order. First match wins.
  One theme setting controls visibility for cards and product details.
  Promotional label only: does not change prices or apply discounts.
{%- endcomment -%}
{%- if settings.collection_discount_enabled -%}
  {%- assign badge_percentage = 0 -%}
  {%- for rule_index in (1..10) -%}
    {%- assign collection_key = 'fixed_discount_collection' -%}
    {%- assign percentage_key = 'fixed_discount_percentage' -%}
    {%- assign background_key = 'fixed_discount_background' -%}
    {%- assign text_key = 'fixed_discount_text' -%}
    {%- if rule_index > 1 -%}
      {%- assign collection_key = collection_key | append: '_' | append: rule_index -%}
      {%- assign percentage_key = percentage_key | append: '_' | append: rule_index -%}
      {%- assign background_key = background_key | append: '_' | append: rule_index -%}
      {%- assign text_key = text_key | append: '_' | append: rule_index -%}
    {%- endif -%}
    {%- assign rule_collection = settings[collection_key] -%}
    {%- assign rule_percentage = settings[percentage_key] | default: 0 -%}
    {%- if rule_collection != blank and rule_percentage > 0 -%}
      {%- for badge_collection in product.collections -%}
        {%- if badge_collection.handle == rule_collection.handle -%}
          {%- assign badge_percentage = rule_percentage -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if badge_percentage > 0 -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if badge_percentage > 0 -%}
    <p class="{{ badge_class | escape }}" style="background-color: {{ settings[background_key] | default: '#e18a38' | escape }}; color: {{ settings[text_key] | default: '#ffffff' | escape }};">-{{ badge_percentage }}%</p>
  {%- endif -%}
{%- endif -%}
