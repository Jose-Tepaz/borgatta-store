{%- comment -%}
  Product-page notices configured in theme settings. A selected product takes
  precedence over the collection. First matching nonempty message wins.
{%- endcomment -%}
{%- if template.name == 'product' and settings.collection_notice_enabled -%}
  {%- for notice_index in (1..10) -%}
    {%- assign notice_prefix = 'collection_notice_' | append: notice_index | append: '_' -%}
    {%- assign collection_key = notice_prefix | append: 'collection' -%}
    {%- assign product_key = notice_prefix | append: 'product' -%}
    {%- assign notice_product = settings[product_key] -%}
    {%- assign message_key = notice_prefix | append: 'message' -%}
    {%- assign notice_collection = settings[collection_key] -%}
    {%- assign notice_message = settings[message_key] | strip -%}
    {%- assign notice_matches = false -%}
    {%- if notice_message != blank -%}
      {%- if notice_product != blank -%}
        {%- if notice_product.id == product.id -%}
          {%- assign notice_matches = true -%}
        {%- endif -%}
      {%- elsif notice_collection != blank -%}
        {%- for product_collection in product.collections -%}
          {%- if product_collection.handle == notice_collection.handle -%}
            {%- assign notice_matches = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
    {%- if notice_matches -%}
      {%- assign secondary_key = notice_prefix | append: 'secondary_message' -%}
      {%- assign secondary_color_key = notice_prefix | append: 'secondary_color' -%}
      {%- assign notice_secondary = settings[secondary_key] | strip -%}
      {%- assign icon_key = notice_prefix | append: 'icon' -%}
      {%- assign background_key = notice_prefix | append: 'background' -%}
      {%- assign foreground_key = notice_prefix | append: 'foreground' -%}
      {{- 'product-notice.css' | asset_url | stylesheet_tag -}}
      <div class="preventa-banner product-notice{% if notice_secondary != blank %} product-notice--with-secondary{% endif %}" style="background-color: {{ settings[background_key] | default: '#f0fdf4' | escape }}; color: {{ settings[foreground_key] | default: '#016630' | escape }};">
        {%- if settings[icon_key] != 'none' -%}
          <span class="product-notice__icon" aria-hidden="true">{%- render 'product-notice-icon', notice_icon: settings[icon_key] -%}</span>
        {%- endif -%}
        <div class="product-notice__content">
          <p class="product-notice__message">{{ notice_message | escape | newline_to_br }}</p>
          {%- if notice_secondary != blank -%}
            <p class="product-notice__secondary"{% if settings[secondary_color_key] != blank %} style="color: {{ settings[secondary_color_key] | escape }};"{% endif %}>{{ notice_secondary | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      </div>
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
