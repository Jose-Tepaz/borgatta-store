{%- comment -%}
  Renders video1/video2 metafields for a variant, si existen.
  Uso: {% render 'product-videos', variant: product.selected_or_first_available_variant %}
{%- endcomment -%}

{%- liquid
  assign video1 = variant.metafields.video1.video1
  assign video2 = variant.metafields.video2.video2
-%}

{%- if video1 != blank or video2 != blank -%}
  <div class="card__section">
    <p class="text-ficha">Videos</p>

    {%- if video1 != blank -%}
      {%- assign video1_id = video1 | split: '/' | last -%}
      <iframe
        class="wrapp-video"
        width="100%"
        height="345"
        src="https://www.youtube.com/embed/{{ video1_id }}"
        title="Video producto 1"
        loading="lazy"
        frameborder="0"
        allowfullscreen
      ></iframe>
    {%- endif -%}

    {%- if video2 != blank -%}
      {%- assign video2_id = video2 | split: '/' | last -%}
      <iframe
        class="wrapp-video"
        width="100%"
        height="345"
        src="https://www.youtube.com/embed/{{ video2_id }}"
        title="Video producto 2"
        loading="lazy"
        frameborder="0"
        allowfullscreen
      ></iframe>
    {%- endif -%}
  </div>
{%- endif -%}